<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.egmp.bluetoothpan"
    android:versionCode="310"
    android:versionName="3.1.0">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 이 헤드유닛의 KitKat Activity.finish() 구현에 필요 (뒤로 가기 시 강제 종료 방지) -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <application android:label="블루투스 PAN" android:icon="@drawable/icon" android:allowBackup="false"
        android:theme="@android:style/Theme.Holo.NoActionBar">
        <activity android:name="org.egmp.bluetoothpan.MainActivity" android:label="블루투스 PAN"
            android:screenOrientation="landscape" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="org.egmp.bluetoothpan.PanControllerService" android:exported="true" />
    </application>
</manifest>
